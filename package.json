{
	"name": "woocommerce-analytics",
	"version": "0.9.12",
	"description": "Premium Analytics plugin.",
	"author": "WooCommerce",
	"license": "GPL-3.0-or-later",
	"homepage": "https://woocommerce.com/",
	"repository": {
		"type": "git",
		"url": "https://github.com/woocommerce/woocommerce-analytics.git"
	},
	"bugs": {
		"url": "https://github.com/woocommerce/woocommerce-analytics/issues"
	},
	"config": {
		"translate": true,
		"version_replace_paths": [
			"src",
			"woocommerce-analytics.php"
		]
	},
	"scripts": {
		"prearchive": "rm -rf $npm_package_name && rm -rf $npm_package_name.zip && mv ./vendor/woocommerce/analytics/dependencies/src ./temporary_analytics_dependencies_src && rm -rf ./vendor && composer install --no-dev --optimize-autoloader && rm -rf ./vendor/woocommerce/analytics/dependencies/src && mv ./temporary_analytics_dependencies_src ./vendor/woocommerce/analytics/dependencies/src && composer dump-autoload -o",
		"archive": "wp-scripts plugin-zip --no-root-folder",
		"postarchive": "rm -rf $npm_package_name && unzip -q $npm_package_name.zip -d $npm_package_name && rm $npm_package_name.zip && rm $npm_package_name/package.json $npm_package_name/README.md && zip -rq $npm_package_name.zip $npm_package_name && rm -rf $npm_package_name",
		"prebuild": "composer install --optimize-autoloader",
		"build": "npm run build:features && npm run build:assets && npm run i18n",
		"build:heavy": "npm run build && mkdir $npm_package_name && cp -r build $npm_package_name/ && mkdir $npm_package_name/features && cp features/feature-config.php $npm_package_name/features/ && zip -rq $npm_package_name.zip $npm_package_name && rm -rf $npm_package_name && echo '### Heavy build complete 🏋️‍♂️'",
		"build:assets": "NODE_ENV=production wp-scripts build && npm run parse-index-asset",
		"build:features": "NODE_ENV=production node bin/generate-feature-config.js",
		"build:features:dev": "NODE_ENV=development node bin/generate-feature-config.js",
		"build:analyze": "wp-scripts build --webpack-bundle-analyzer",
		"postbuild": "npm run archive",
		"i18n": "WP_CLI_PHP_ARGS='-d memory_limit=2048M' ./vendor/bin/wp i18n make-pot ./ languages/$npm_package_name.pot --slug=$npm_package_name --domain=$npm_package_name --include=src/,woocommerce-analytics.php,build/",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "wp-scripts lint-style --fix",
		"lint:js": "wp-scripts lint-js js/src",
		"lint:js:fix": "wp-scripts lint-js js/src --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"packages-update": "wp-scripts packages-update",
		"start": "npm run build:features:dev && concurrently --kill-others --raw --handle-input \"wp-scripts start\" \"tsc --noEmit --watch\"",
		"start:hot": "npm run build:features:dev && wp-scripts start --hot",
		"lint:php": "vendor/bin/phpcs -p -s --colors",
		"lint:php:summary": "vendor/bin/phpcs --colors --report=summary",
		"lint:php:fix": "vendor/bin/phpcbf -p -s --colors",
		"test:php": "composer test-unit",
		"test:js": "wp-scripts test-unit-js",
		"parse-index-asset": "node bin/parse-index-asset.js",
		"typecheck": "tsc --noEmit",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"deploy-storybook": "storybook-to-ghpages",
		"build:next-admin": "cd js && npm install && npm run build",
		"start:next-admin": "cd js && npm run dev",
		"build:deploy": "composer install && npm run build:features && npm run build:assets && npm run build:next-admin",
		"sync-staging": "node bin/rsync-to-staging/rsync-to-staging.js"
	},
	"devDependencies": {
		"@babel/preset-env": "^7.24.0",
		"@babel/preset-react": "^7.24.0",
		"@babel/preset-typescript": "^7.25.7",
		"@chromatic-com/storybook": "^3.2.2",
		"@emotion/babel-plugin": "^11.13.5",
		"@storybook/addon-actions": "^8.5.8",
		"@storybook/addon-essentials": "^8.4.7",
		"@storybook/addon-interactions": "^8.4.7",
		"@storybook/addon-onboarding": "^8.4.7",
		"@storybook/addon-viewport": "^8.5.1",
		"@storybook/nextjs": "^8.4.7",
		"@storybook/storybook-deployer": "^2.8.16",
		"@storybook/test": "^8.4.7",
		"@svgr/webpack": "^8.1.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/react": "^16.0.0",
		"@testing-library/react-hooks": "^8.0.1",
		"@types/jest": "^29.5.14",
		"@types/wordpress__data": "^6.0.0",
		"@types/wordpress__keycodes": "2.3.3",
		"@types/wordpress__notices": "^3.5.0",
		"@woocommerce/dependency-extraction-webpack-plugin": "^3.0.1",
		"@woocommerce/eslint-plugin": "^2.3.0",
		"@wordpress/base-styles": "^5.0.1",
		"@wordpress/eslint-plugin": "^21.5.0",
		"@wordpress/prettier-config": "^4.0.1",
		"@wordpress/scripts": "^30.7.0",
		"@wordpress/stylelint-config": "^22.0.1",
		"concurrently": "^9.1.0",
		"eslint-import-resolver-typescript": "^3.7.0",
		"eslint-import-resolver-webpack": "^0.13.10",
		"eslint-plugin-storybook": "^0.11.1",
		"jest": "^29.7.0",
		"php-parser": "^3.1.5",
		"prettier": "npm:wp-prettier@^3.0.3",
		"prop-types": "^15.8.1",
		"react-test-renderer": "^17.0.2",
		"storybook": "^8.4.7",
		"terser-webpack-plugin": "^5.3.10"
	},
	"dependencies": {
		"@automattic/charts": "^0.19.1",
		"@automattic/interpolate-components": "^1.2.1",
		"@automattic/jetpack-connection": "^0.35.14",
		"@automattic/number-formatters": "^1.0.4",
		"@automattic/site-admin": "^0.1.3",
		"@automattic/ui": "^1.0.2",
		"@date-fns/tz": "^1.2.0",
		"@emotion/react": "^11.11.0",
		"@emotion/styled": "^11.11.0",
		"@woocommerce/components": "^12.3.0",
		"@woocommerce/currency": "^4.3.0",
		"@woocommerce/data": "^5.0.0",
		"@woocommerce/date": "^4.3.0",
		"@woocommerce/navigation": "^8.2.0",
		"@woocommerce/number": "^2.5.0",
		"@woocommerce/onboarding": "^3.6.0",
		"@woocommerce/settings": "^1.0.0",
		"@woocommerce/tracks": "^1.4.0",
		"@wordpress/api-fetch": "^7.0.1",
		"@wordpress/commands": "^1.16.0",
		"@wordpress/components": "^28.0.3",
		"@wordpress/core-data": "^7.16.0",
		"@wordpress/data": "^10.21.0",
		"@wordpress/dataviews": "^5.0.1-next.719a03cbe.0",
		"@wordpress/dom": "^4.16.0",
		"@wordpress/editor": "^14.16.0",
		"@wordpress/element": "^6.16.0",
		"@wordpress/hooks": "^4.18.0",
		"@wordpress/html-entities": "^4.16.0",
		"@wordpress/i18n": "^5.0.1",
		"@wordpress/icons": "^10.16.0",
		"@wordpress/keycodes": "^4.16.0",
		"@wordpress/preferences": "^4.19.0",
		"@wordpress/primitives": "^4.14.0",
		"@wordpress/url": "^4.0.1",
		"classnames": "^2.5.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"history": "^5.3.0",
		"lodash": "^4.17.21",
		"moment": "^2.30.1",
		"react-spring": "^9.7.4",
		"route-recognizer": "^0.3.4"
	},
	"files": [
		"changelog.txt",
		"languages",
		"src",
		"vendor",
		"composer.json",
		"woocommerce-analytics.php"
	],
	"overrides": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0"
	},
	"woorelease": {
		"wp_org_slug": "premium-analytics",
		"translate": true,
		"version_replace_paths": [
			"./"
		],
		"use_gh_release_notes": true
	}
}
